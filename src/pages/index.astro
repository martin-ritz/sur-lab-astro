---
import Layout from '../layouts/Layout.astro';
import UtilCard from '../components/UtilCard.astro';
import { utils } from '../data/utils';
---

<Layout
	title="Small tools for working across borders"
	description="Free tools for working with clients in other countries: an exact world clock and time zones. No cookies, no tracking, no sign-up. Made by SUR."
>
	<h1 class="text-h1">Small tools for working across borders.</h1>
	<h2 class="text-h2 max-w-xl md:mt-8">Free, no sign-up, nothing to install. Made by SUR, a web studio that works with clients wherever they are.</h2>

	<section class="section-space grid gap-14 md:grid-cols-2 md:gap-x-8 md:gap-y-18">
		{utils.map((u) => <UtilCard util={u} />)}
	</section>
</Layout>