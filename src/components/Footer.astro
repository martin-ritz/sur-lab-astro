---
const year = new Date().getFullYear();
---

<footer class="mb-10">
  <div class="border-t border-lab mt-20 text-sm pt-6 pb-4 flex flex-col gap-y-4 md:flex-row md:justify-between">
    <p class="font-mono text-muted">Lab is a project of&nbsp;
      <a href="https://www.madebysur.com" target="_blank" class="text-fg underline underline-offset-4 hover:text-muted">SUR</a>. Need a website or an app?&nbsp;
      <a href="https://www.madebysur.com/contact" target="_blank" class="text-fg underline underline-offset-4 hover:text-muted">Get in touch</a>.
    </p>
    <p class="font-mono text-muted">Nothing you type here is sent or tracked.</p>
  </div>
  <p class="text-muted font-mono text-sm">© <span data-year>{year}</span>&nbsp;SUR</p>
</footer>
<script>
  document.querySelectorAll("[data-year]").forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>