---
// One city card.
// CityList puts it inside a <template>: a blueprint the script copies once per city.
// Everything marked data-city-… is filled in by the script; the text below is only
// placeholder text so you can see the design while building.
import StarOutline from "../assets/star-outline.svg";
---

<article data-city-card class="group flex flex-col rounded-2xl bg-card p-5">
  <!-- Top row: name and country on the left, buttons on the right -->
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <h3 data-city-name class="text-xl font-semibold leading-tight">Prague</h3>
      <p class="mt-0.5 text-sm text-muted">
        <span data-city-country>Czechia</span> · <span data-city-zone>CET</span>
      </p>
    </div>

    <div class="-mt-1.5 -mr-2 flex shrink-0">
      <button type="button" data-city-home aria-label="Make Prague home" class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-card-hover hover:text-fg">
        <StarOutline class="size-4.5" aria-hidden="true" />
      </button>
      <button type="button" data-city-remove aria-label="Remove Prague" class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-card-hover hover:text-fg">
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg>
      </button>
    </div>
  </div>

  <!-- Time, with a sun or a moon next to it -->
  <p class="mt-4 flex items-baseline gap-2.5">
    <span data-city-time class="font-mono text-5xl font-medium leading-none tracking-tight clock-sans:font-sans">15:46</span>
    <span class="text-muted" aria-hidden="true">
      <!-- Sun: shown by default. The script adds data-night to the card at night. -->
      <svg class="size-5 group-data-night:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <!-- Moon: only at night -->
      <svg class="hidden size-5 group-data-night:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
    </span>
  </p>

  <p data-city-diff class="mt-2.5 text-sm font-medium">1 h behind you</p>

  <!-- Bottom row: the day on the left, the status chip on the right -->
  <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2 border-t border-lab pt-3 text-sm">
    <span data-city-day class="text-muted">Today</span>
    <span data-city-status class="rounded-full bg-lab px-2.5 py-0.5">Working hours</span>
  </div>
</article>
