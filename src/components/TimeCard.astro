---
import Switch from "./Switch.astro";
---

<section>
  <div data-clock-card class="relative rounded-2xl bg-card px-7 py-4 md:px-15 md:py-10 clock-mode:flex clock-mode:flex-col clock-mode:items-center clock-mode:justify-center clock-mode:rounded-none clock-mode:bg-bg">
    <p class="text-muted"><span data-home-place>Right now where you are</span>, <strong data-home-name class="font-semibold text-fg"></strong></p>
    <div data-big-clock
      class="flex items-baseline font-mono text-clock font-semibold clock-sans:font-sans">
      <p data-big-time>--:--</p>
      <p class="text-muted text-[0.32em]">
        <span data-big-sec>:--</span>
        <span data-big-period></span>
      </p>
    </div>
    <p data-big-date class="mb-4 text-muted clock-mode:mb-0"></p>

    <hr class="text-lab clock-mode:hidden">
    <p data-clock-accuracy class="mt-2 text-sm text-muted clock-mode:hidden">Checking your clock…</p>

    <!-- Clock mode only: your other cities in a row under the big clock (filled by the script) -->
    <ul data-clock-strip class="hidden clock-mode:mt-16 clock-mode:flex clock-mode:flex-wrap clock-mode:justify-center clock-mode:gap-x-12 clock-mode:gap-y-6"></ul>

    <button type="button" data-exit-fullscreen class="hidden clock-mode:block absolute top-6 right-6 rounded-full bg-card px-4 py-2 text-sm text-muted hover:text-fg">
      Exit: Esc
    </button>
  </div>
</section>

<div class="mt-5 px-7 py-4 md:px-5 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
  <Switch name="awake" label="Keep screen awake" description="Your screen won’t dim or lock while this tab is open." descriptionOn="Screen stays on. Switch tabs and it pauses; come back and it’s on again." hidden />
  <Switch name="h12" label="12-hour clock" description="Show 2:30 PM instead of 14:30." descriptionOn="Times showing as 2:30 PM." />
  <Switch name="sans" label="Plain numbers" description="Swap the typewriter digits for a cleaner font." descriptionOn="Showing time in a sans-serif font."/>
  <Switch name="fullscreen" label="Clock mode" description="Show only the clock, full screen. Your screen stays on." hidden />
</div>

<script>
  import { onSwitch, setSwitch, showSwitch } from "../scripts/switches";
  import { exactNow, getOffset, startSync, everySecond } from "../scripts/exact-time";
  import { getHome, homeTz, homeRef, getIds, findPlace } from "../scripts/time-store";
  import { zoneLongName, longDate, utcLabel, offsetMinutes, isoWeek, formatTime, describeDifference } from "../scripts/time-utils";

  const root = document.documentElement; // the <html> element

    // --- 1. Keep screen awake ---
  // Awake when the switch is on OR the clock is in clock mode (full screen)
  if ("wakeLock" in navigator) {
    showSwitch("awake");
    let lock: WakeLockSentinel | null = null;
    let wanted = false;    // the "Keep screen awake" switch
    let clockMode = false; // the clock card is full screen

    const turnOn = async () => {
      try {
        lock = await navigator.wakeLock.request("screen");
        lock.addEventListener("release", () => (lock = null));
      } catch {
        wanted = false;
        setSwitch("awake", false);
      }
    };

    // Check whether the screen should stay awake right now, and act on it
    const update = async () => {
      const needed = wanted || clockMode;
      if (needed && !lock) await turnOn();
      if (!needed && lock) { await lock.release(); lock = null; }
    };

    onSwitch("awake", (on) => { wanted = on; update(); });

    document.addEventListener("fullscreenchange", () => {
      clockMode = !!document.fullscreenElement;
      update();
    });

    // The browser drops the lock when you switch tabs; take it back when you return
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") update();
    });
  }

  // --- 2 & 3. 12-hour clock and plain numbers: saved on <html>, remembered next visit ---
  const remember = (key: string, on: boolean) => {
    try { localStorage.setItem(key, String(on)); } catch {}
  };
  const recall = (key: string) => {
    try { return localStorage.getItem(key) === "true"; } catch { return false; }
  };

  const h12 = recall("clock-h12");
  root.dataset.hour12 = String(h12);
  setSwitch("h12", h12);
  onSwitch("h12", (on) => {
    root.dataset.hour12 = String(on);
    remember("clock-h12", on);
    window.dispatchEvent(new Event("clock-format")); // tell the clocks to redraw now
  });

  const sans = recall("clock-sans");
  root.dataset.clockFont = sans ? "sans" : "mono";
  setSwitch("sans", sans);
  onSwitch("sans", (on) => {
    root.dataset.clockFont = on ? "sans" : "mono";
    remember("clock-sans", on);
  });

  // --- 4. Clock mode (full screen, only the clock) ---
  const clockCard = document.querySelector<HTMLElement>("[data-clock-card]");

  if (document.fullscreenEnabled && clockCard) {
    showSwitch("fullscreen");

    onSwitch("fullscreen", (on) => {
      if (on) clockCard.requestFullscreen(); // only the card, not the whole page
      else document.exitFullscreen();
    });

    document.querySelector("[data-exit-fullscreen]")?.addEventListener("click", () => {
      document.exitFullscreen();
    });

    // Esc or the Exit button also leave clock mode, so keep the switch in sync
    document.addEventListener("fullscreenchange", () => {
      setSwitch("fullscreen", !!document.fullscreenElement);
    });
  }

  // ---------- Exact time ----------
  // The measuring lives in src/scripts/exact-time.ts (shared with the preview card).
  // Here we only write the line under the clock.
  const accuracyLine = document.querySelector<HTMLElement>("[data-clock-accuracy]");

  function showAccuracy() {
    if (!accuracyLine) return;
    const offset = getOffset();
    const seconds = Math.abs(offset) / 1000;
    if (seconds < 0.1) {
      accuracyLine.textContent = "Your device clock is exact.";
    } else {
      // offset > 0: the server is ahead, so the device is behind
      const direction = offset > 0 ? "behind" : "ahead";
      accuracyLine.textContent = `Your device clock is ${seconds.toFixed(1)} s ${direction}. This page shows the exact time.`;
    }
  }

  window.addEventListener("clock-sync-failed", () => {
    if (accuracyLine) accuracyLine.textContent = "Couldn’t check your clock, showing your device’s time.";
  });

  startSync(); // measure now, then every 15 minutes and when the tab comes back

  // ---------- Home ----------
  // Home is the visitor's own time zone, unless they starred a city under "Your cities".
  // That choice lives in src/scripts/time-store.ts; homeTz() always gives the right zone.
  const homePlace = document.querySelector<HTMLElement>("[data-home-place]");
  const homeName = document.querySelector<HTMLElement>("[data-home-name]");
  const bigDate = document.querySelector<HTMLElement>("[data-big-date]");
  const strip = document.querySelector<HTMLElement>("[data-clock-strip]");

  // Clock mode: one small clock per city (except home), rebuilt every second while full screen
  function drawStrip(now: number, tz: string, hour12: boolean) {
    if (!strip) return;
    const home = getHome();
    const items = getIds()
      .filter((id) => id !== home?.id)
      .flatMap((id) => findPlace(id) ?? []) // skip ids that don't exist
      .map((place) => {
        const li = document.createElement("li");
        li.className = "text-center";

        const name = document.createElement("p");
        name.className = "text-sm text-muted";
        name.textContent = place.name;

        const time = document.createElement("p");
        time.className = "mt-1 font-mono text-4xl font-medium clock-sans:font-sans";
        time.textContent = formatTime(place.tz, now, hour12);

        const diff = document.createElement("p");
        diff.className = "mt-1 text-sm text-muted";
        diff.textContent = describeDifference(offsetMinutes(place.tz, now) - offsetMinutes(tz, now), homeRef());

        li.append(name, time, diff);
        return li;
      });
    strip.replaceChildren(...items);
  }

  // ---------- Big clock ----------
  const big = document.querySelector<HTMLElement>("[data-big-clock]");
  const bigTime = document.querySelector<HTMLElement>("[data-big-time]");
  const bigSec = document.querySelector<HTMLElement>("[data-big-sec]");
  const bigPeriod = document.querySelector<HTMLElement>("[data-big-period]");

  function tickBig() {
    if (!big || !bigTime || !bigSec || !bigPeriod) return;

    const hour12 = root.dataset.hour12 === "true";
    const tz = homeTz();
    const now = exactNow();
    const home = getHome();

    // Ask for the time at home, split into separate pieces
    const parts = new Intl.DateTimeFormat("en-GB", {
      timeZone: tz,
      hour: hour12 ? "numeric" : "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hourCycle: hour12 ? "h12" : "h23",
    }).formatToParts(now);

    // Turn the list of pieces into an easy lookup: get("hour") → "19"
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "";

    bigTime.textContent = `${get("hour")}:${get("minute")}`;
    bigSec.textContent = `:${get("second")}`;
    bigPeriod.textContent = hour12 ? ` ${get("dayPeriod").toUpperCase()}` : "";

    // The line above the clock: "Right now where you are" or "Right now in Oaxaca", plus the zone name
    if (homePlace) homePlace.textContent = home ? `Right now in ${home.name}` : "Right now where you are";
    if (homeName) homeName.textContent = zoneLongName(tz, now);

    // The line under the clock: "Sunday, 15 November 2026 · UTC+1 · Week 46"
    if (bigDate) bigDate.textContent = `${longDate(tz, now)} · ${utcLabel(offsetMinutes(tz, now))} · Week ${isoWeek(tz, now)}`;

    if (document.fullscreenElement) drawStrip(now, tz, hour12);
  }

  // Update at the start of every exact second
  everySecond(tickBig);

  // After each measurement: update the line and show the corrected time right away
  window.addEventListener("clock-synced", () => {
    showAccuracy();
    tickBig();
  });

  // Redraw immediately when the 12-hour switch is flipped, or home / the city list changes
  window.addEventListener("clock-format", tickBig);
  window.addEventListener("time-change", tickBig);
  document.addEventListener("fullscreenchange", tickBig);


</script>