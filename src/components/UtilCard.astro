---
interface Props {
  util: {
    title: string;
    description: string;
    path: string;
    Preview: any;
  };
}

const { util } = Astro.props;
const Preview = util.Preview;    // components must be in a capitalised variable to use as a tag
---

<a href={util.path} class="group block">
  <div class="grid aspect-16/10 place-items-center rounded-2xl bg-card transition-colors group-hover:bg-card-hover">
    <Preview />
  </div>

  <div class="mt-6 flex items-start justify-between gap-6">
    <div>
      <h2 class="text-title">{util.title}</h2>
      <p class="text-muted mt-1.5">{util.description}</p>
    </div>
  </div>

  <p class="mt-3 text-sm text-muted font-mono">lab.madebysur.com{util.path}</p>
</a>