---
interface Props {
  util: {
    title: string;
    description: string;
    url: string;
  };
}

const { util } = Astro.props;
---

<a href={`https://${util.url}`} class="group block">
  <div class="rounded-2xl bg-card transition-colors group-hover:bg-card-hover">
    <div>IMAGE</div>
  </div>

  <div class="mt-6 flex items-start justify-between gap-6">
    <div>
      <h2 class="text-title">{util.title}</h2>
      <p class="text-muted mt-1.5">{util.description}</p>
    </div>
    <span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span>
  </div>

  <p class="mt-3 text-sm text-muted font-mono">{util.url}</p>
</a>